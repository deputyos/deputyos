# deputyOS PWA — long-running companion service.
#
# This unit is a documented contract; it is consumed by future bake-side
# wiring at roles/deputyos/tasks/pwa-baseline.yml when M3-rest finishes.
# Until then, the binary runs locally via `make pwa`.
#
# Trust model: M3-PWA is LAN-trusted (same trust the wizard hands off when it
# completes). Operators wanting stronger auth layer Tailscale or
# Cloudflare Tunnel — both already wired by the wizard's M3 lanes.

[Unit]
Description=deputyOS PWA
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agent
Group=agent
ExecStart=/usr/local/bin/deputypwa serve --port 8089 --bind 0.0.0.0
Restart=always
RestartSec=5
# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/deputyos
ProtectHome=read-only
ReadOnlyPaths=/etc/deputyos
SystemCallFilter=@system-service
RestrictNamespaces=true

[Install]
WantedBy=multi-user.target
